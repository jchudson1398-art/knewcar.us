---
// An iPhone-style frame around a real KnewCar app screenshot.
interface Props { src: string; alt: string; width?: number; tilt?: number; class?: string }
const { src, alt, width = 300, tilt = 0, class: cls = "" } = Astro.props;
---

<figure class={`phone ${cls}`} style={`--w:${width}px; --tilt:${tilt}deg`}>
  <div class="screen">
    <img src={src} alt={alt} loading="lazy" width="600" height="1300" />
    <span class="island" aria-hidden="true"></span>
  </div>
</figure>

<style>
  .phone {
    margin: 0; width: var(--w); max-width: 100%; aspect-ratio: 600 / 1300;
    padding: calc(var(--w) * 0.035); border-radius: calc(var(--w) * 0.16);
    background: linear-gradient(145deg, #2b3532, #0b0f0e 40%, #1d2422);
    box-shadow: 0 0 0 1.5px #3c4744 inset, 0 40px 80px rgba(0, 0, 0, 0.55), 0 0 60px rgba(92, 235, 196, 0.10);
    transform: rotate(var(--tilt));
  }
  .screen { position: relative; width: 100%; height: 100%; border-radius: calc(var(--w) * 0.13); overflow: hidden; background: #000; }
  .screen img { width: 100%; height: 100%; object-fit: cover; }
  .island {
    position: absolute; top: calc(var(--w) * 0.035); left: 50%; transform: translateX(-50%);
    width: 32%; height: calc(var(--w) * 0.085); border-radius: 999px; background: #000;
  }
</style>
