---
import { NAV } from "../site";
import Wordmark from "./Wordmark.astro";
---

<header class="top">
  <div class="wrap wide bar">
    <a href="/" class="home" aria-label="KnewCar home"><Wordmark /></a>
    <nav aria-label="Main">
      {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <a href="/sign-in" class="account">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"></path></svg>
      Account
    </a>
  </div>
</header>

<style>
  .top {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    background: rgba(4, 20, 15, 0.78); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(160, 230, 205, 0.1);
  }
  .bar { display: flex; align-items: center; gap: 40px; height: 72px; }
  .home { display: flex; text-decoration: none; }
  nav { display: flex; gap: 30px; }
  nav a { color: var(--text); font-weight: 600; font-size: 15px; padding: 12px 0; }
  nav a:hover { color: var(--mint); text-decoration: none; }
  .account {
    margin-left: auto; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 12px;
    border: 1px solid rgba(232, 243, 238, 0.3); color: var(--text); font-weight: 600; font-size: 15px;
  }
  .account:hover { border-color: var(--mint); text-decoration: none; }
  @media (max-width: 720px) {
    .bar { gap: 14px; height: 64px; }
    nav { gap: 16px; overflow-x: auto; scrollbar-width: none; }
    nav::-webkit-scrollbar { display: none; }
    nav a { font-size: 14px; white-space: nowrap; }
    nav a:nth-child(n + 3) { display: none; }
  }
  @media (max-width: 420px) {
    nav a:nth-child(n + 2) { display: none; }
    .account { padding: 0 12px; }
  }
</style>
