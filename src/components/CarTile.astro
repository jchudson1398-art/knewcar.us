---
// One card in the grid. With a configuration it shows that exact build (trim, year, drivetrain, body) with its own
// photo and MSRP; with a trim, that trim; with neither, the model and its lowest verified MSRP. Either way it opens the model's page with every trim. No payments or offers.
import { carImage, carName, carSearchText, carUrl, money, priceLabel, trimImage, type Car, type Config } from "../lib/catalog";
interface Props { car: Car; trim?: Car["trims"][number]; config?: Config; eager?: boolean; hide?: boolean }
const { car, trim, config, eager = false, hide = false } = Astro.props;
const year = config?.year ?? car.year;
const detail = config ? [config.drive, config.body].filter(Boolean).join(" · ") : "";
const title = `${year} ${car.make} ${car.model}`;
// The line under the name: the trim and build for one configuration, or how many trims for a model.
const sub = config ? [config.trim, detail].filter(Boolean).join(" · ") : trim ? trim.name : `${car.trims.length} ${car.trims.length === 1 ? "trim" : "trims"}`;
const full = config || trim ? `${title} ${sub}` : title;
const price = config ? config.msrp : trim ? trim.msrp : car.msrpFrom;
// A model marked "Hybrid available" has hybrid and non-hybrid builds: a single build says which it is by its trim name.
const oneName = config?.trim ?? trim?.name;
const fuel = oneName && car.fuel === "Hybrid available" ? (/hybrid|phev|plug-in|i-force max/i.test(oneName) ? "Hybrid" : null) : car.fuel;
const one = config ?? trim;
const label = one ? (one.msrp ? `${money(one.msrp)} MSRP` : "MSRP in the app") : priceLabel(car);
const text = config ? `${carSearchText(car)} ${config.year} ${config.trim} ${config.drive ?? ""} ${config.body ?? ""}`.toLowerCase() : trim ? `${carSearchText(car)} ${trim.name.toLowerCase()} ${trim.drive.join(" ").toLowerCase()}` : carSearchText(car);
const image = config ? `/img/cfg/${config.img}.webp` : trim ? trimImage(car, trim) : carImage(car);
---

<article class="tile" data-tile hidden={hide} data-kind={config ? "config" : trim ? "trim" : "model"} data-make={car.make} data-text={text} data-type={car.type ?? ""} data-fuel={fuel ?? ""} data-drive={config?.drive ?? ""} data-price={price ?? ""} data-name-sort={`${car.make} ${car.model} ${9999 - year} ${sub}`}>
  <a class="frame" href={carUrl(car)} aria-label={`${full}: see every configuration`}>
    <img src={image} alt={full} width="560" height="420" loading={eager ? "eager" : "lazy"} decoding="async" />
    {fuel && <span class="fuel">{fuel}</span>}
  </a>
  <div class="info">
    <div class="row">
      <h3><a href={carUrl(car)}>{title}</a></h3>
      <button type="button" class="save" data-save={car.key} aria-pressed="false" aria-label={`Save ${carName(car)}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"></path></svg></button>
    </div>
    <p class="sub">{sub}</p>
    <div class="row">
      <p class="price">{label}</p>
      <button type="button" class="cmp" data-compare={car.key} data-compare-short aria-pressed="false">Compare</button>
    </div>
  </div>
</article>

<style>
  .tile { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .tile[hidden] { display: none; }
  .frame { position: relative; display: block; border-radius: 12px; overflow: hidden; background: #0b221c; border: 1px solid rgba(160, 230, 205, 0.12); transition: border-color .2s ease, box-shadow .2s ease; }
  .frame img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: center 58%; transition: transform .5s ease; }
  .frame:hover, .frame:focus-visible { border-color: rgba(92, 235, 196, 0.6); box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45); text-decoration: none; }
  .frame:hover img { transform: scale(1.04); }
  .fuel { position: absolute; left: 8px; top: 8px; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 999px; background: rgba(4, 20, 15, 0.82); color: var(--mint); }
  .info { padding: 0 4px; display: grid; gap: 1px; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; }
  h3 { font-size: 15px; font-weight: 700; letter-spacing: -0.01em; min-width: 0; overflow-wrap: anywhere; }
  h3 a { color: var(--text); }
  .sub { margin: 0; font-size: 13px; color: var(--sub); overflow-wrap: anywhere; }
  .price { margin: 0; font-size: 15px; font-weight: 800; white-space: nowrap; }
  .save, .cmp { flex: none; border: 0; background: none; color: var(--text); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .save { width: 44px; height: 44px; margin: -6px -12px -6px 0; }
  .save:hover, .cmp:hover { color: var(--mint); }
  .save[aria-pressed="true"] { color: var(--mint); }
  .save[aria-pressed="true"] svg { fill: currentColor; }
  .cmp { min-height: 44px; margin: -4px 0; padding: 0 0 0 8px; font: 600 12px var(--font); color: var(--sub); gap: 5px; white-space: nowrap; }
  .cmp::before { content: "\21C6"; font-size: 13px; }
  .cmp[aria-pressed="true"] { color: var(--mint); }
  @media (prefers-reduced-motion: reduce) { .frame, .frame img { transition: none; } }
</style>
