---
import Base from "../layouts/Base.astro";
import Phone from "../components/Phone.astro";
import Waitlist from "../components/Waitlist.astro";
import Icon from "../components/Icon.astro";
import { PRICES } from "../site";
---

<Base title="KnewCar" description="Shop new cars by the monthly payment that fits your budget. See realistic estimated payments for your credit range, with current manufacturer offers and every assumption shown, before you go to the dealership.">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Shop by budget, not by sticker</p>
        <h1>Your <span class="mint">payment-first</span> new car shopping tool.</h1>
        <p class="lead">
          Your budget. Your credit range. Your next car. KnewCar brings them together with realistic payment estimates
          and the details behind every number.
        </p>
        <div id="waitlist" class="hero-form">
          <Waitlist id="hero-waitlist" />
        </div>
        <ul class="ticks">
          <li><Icon name="check" size={18} /> No credit check</li>
          <li><Icon name="check" size={18} /> Not a dealer or a lender</li>
          <li><Icon name="check" size={18} /> {PRICES.trialDays}-day free trial at launch</li>
        </ul>
      </div>
      <div class="hero-phones">
        <Phone src="/img/screen-swipe.jpg" alt="KnewCar Swipe screen showing a vehicle with its estimated monthly payment" width={250} tilt={-6} class="back" />
        <Phone src="/img/screen-browse.jpg" alt="KnewCar Browse screen listing new cars that fit a monthly payment" width={290} tilt={4} class="front" />
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="section tight problem">
    <div class="wrap center">
      <h2>Most people fall in love with the car <span class="mint">before they know what it actually costs.</span></h2>
      <p class="lead">
        By the time the real monthly number shows up, you're already attached to a car that may not fit your budget.
        KnewCar flips that around: your budget comes first, and the cars come second.
      </p>
    </div>
  </section>

  <!-- Know your payment -->
  <section class="section" id="budget">
    <div class="wrap budget-grid">
      <div>
        <p class="eyebrow">Know your payment</p>
        <h2>Your credit range <span class="mint">changes the payment.</span></h2>
        <p class="lead">
          Two people can buy the same car at the same price and pay very different amounts each month. The biggest
          reason is the interest rate, and the rate depends heavily on credit.
        </p>
        <p class="body">
          KnewCar estimates payments using the credit range you choose, so the numbers you see are closer to what a
          lender may actually offer you, not a best-case rate most shoppers won't get. No credit check, and your exact
          score never leaves your phone.
        </p>
      </div>
      <div class="card rate-card">
        <p class="rate-title">Same car. Same price. Different credit.</p>
        <p class="rate-sub">$30,000 financed for 60 months</p>
        <table>
          <thead><tr><th scope="col">Credit range</th><th scope="col">Example APR</th><th scope="col">Monthly</th></tr></thead>
          <tbody>
            <tr><td>Excellent</td><td>5.9%</td><td>$579</td></tr>
            <tr><td>Good</td><td>7.9%</td><td>$607</td></tr>
            <tr><td>Fair</td><td>11.9%</td><td>$666</td></tr>
            <tr><td>Rebuilding</td><td>16.9%</td><td>$744</td></tr>
          </tbody>
        </table>
        <p class="rate-diff">That's a <strong>$165/month</strong> difference, or nearly <strong>$10,000</strong> over the loan.</p>
        <p class="rate-fine">Example for illustration only. Actual rates are set by lenders and vary.</p>
      </div>
    </div>
    <div class="wrap">
      <h3 class="drivers-title">What actually sets your monthly payment</h3>
      <div class="grid grid-3 drivers">
        <div class="driver"><Icon name="shield" /><div><strong>Credit range</strong><span>Sets the rate a lender is likely to offer.</span></div></div>
        <div class="driver"><Icon name="wallet" /><div><strong>Down payment and trade-in</strong><span>Lower the amount you finance, including what you still owe on a trade.</span></div></div>
        <div class="driver"><Icon name="list" /><div><strong>Term, taxes, and fees</strong><span>A longer term lowers the payment but raises the total you pay.</span></div></div>
        <div class="driver"><Icon name="car" /><div><strong>Finance or lease</strong><span>Leases and loans work differently, and so do their payments.</span></div></div>
        <div class="driver"><Icon name="tag" /><div><strong>Manufacturer incentives</strong><span>Cash offers and special rates can help, when you qualify.</span></div></div>
        <div class="driver"><Icon name="check" /><div><strong>Your budget range</strong><span>We only show cars whose estimated payment fits it.</span></div></div>
      </div>
    </div>
  </section>

  <!-- Incentives -->
  <section class="section incentives">
    <div class="wrap budget-grid">
      <div class="card offer-card" aria-label="Example of manufacturer offers shown for a vehicle">
        <div class="offer-head">
          <div>
            <p class="offer-car">2026 compact SUV</p>
            <p class="offer-zip">Offers for ZIP 85001</p>
          </div>
          <span class="fresh"><span class="dot" aria-hidden="true"></span>Checked today</span>
        </div>
        <ul class="offers">
          <li>
            <span class="pill">Cash</span>
            <div><strong>$1,000 Customer Cash</strong><span>Manufacturer lists it through Oct 31.</span></div>
          </li>
          <li>
            <span class="pill">Special APR</span>
            <div><strong>3.9% APR for 60 months</strong><span>May apply with stronger credit. Lender approval required.</span></div>
          </li>
          <li>
            <span class="pill">Lease</span>
            <div><strong>Lease special available</strong><span>Due at signing and mileage limits shown in the app.</span></div>
          </li>
        </ul>
        <p class="rate-fine">Example for illustration only.</p>
      </div>
      <div>
        <p class="eyebrow">Manufacturer incentives, up front</p>
        <h2>Know the deals <span class="mint">before you walk in.</span></h2>
        <p class="lead">
          KnewCar gathers current manufacturer cash offers, promotional rates, and lease specials, and shows which
          ones may apply to you, right next to the payment.
        </p>
        <ul class="bullets">
          <li><Icon name="tag" /><span>See cash back, special APRs, and lease deals for each car in your area.</span></li>
          <li><Icon name="shield" /><span>Know which offers depend on credit or other requirements, so there are no surprises.</span></li>
          <li><Icon name="list" /><span>Offers are re-checked regularly and updated as manufacturers change them, so you're not looking at last month's deals.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" id="how">
    <div class="wrap">
      <p class="eyebrow center">How it works</p>
      <h2 class="center">Three steps to cars that fit your budget.</h2>
      <div class="grid grid-3 steps">
        <article class="card">
          <div class="icon-badge"><Icon name="wallet" /></div>
          <span class="num">1</span>
          <h3>Set your budget</h3>
          <p>Tell us the monthly range you're comfortable with, your estimated credit range, down payment, any trade-in, and your ZIP code.</p>
        </article>
        <article class="card">
          <div class="icon-badge"><Icon name="car" /></div>
          <span class="num">2</span>
          <h3>See cars that fit</h3>
          <p>Browse or swipe through only the new vehicles whose estimated payment fits your range, based on your credit and current offers in your area.</p>
        </article>
        <article class="card">
          <div class="icon-badge"><Icon name="list" /></div>
          <span class="num">3</span>
          <h3>Know what to confirm</h3>
          <p>Every estimate shows how it was calculated and what the dealer and lender still need to confirm.</p>
        </article>
      </div>
      <p class="center more"><a href="/how-it-works">See how estimates work →</a></p>
    </div>
  </section>

  <!-- Feature: Browse -->
  <section class="section feature">
    <div class="wrap feature-grid">
      <div class="feature-phone"><Phone src="/img/screen-browse.jpg" alt="KnewCar Browse screen" width={300} /></div>
      <div>
        <p class="eyebrow">Browse</p>
        <h2>Find cars that fit <span class="mint">your payment.</span></h2>
        <ul class="bullets">
          <li><Icon name="wallet" /><span>Every car shows an estimated monthly payment for your budget and credit range.</span></li>
          <li><Icon name="car" /><span>Filter by the vehicles you actually want, within what fits.</span></li>
          <li><Icon name="tag" /><span>Manufacturer cash and special rates are included when they may apply to you.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Feature: Swipe -->
  <section class="section feature alt">
    <div class="wrap feature-grid reverse">
      <div>
        <p class="eyebrow">Swipe</p>
        <h2>Swipe your way <span class="mint">to the right car.</span></h2>
        <ul class="bullets">
          <li><Icon name="heart" /><span>Like, pass, or save vehicles as you go.</span></li>
          <li><Icon name="bookmark" /><span>Saved cars keep the exact payment setup you saw, with every assumption.</span></li>
          <li><Icon name="phone" /><span>Pick up right where you left off whenever you open the app.</span></li>
        </ul>
      </div>
      <div class="feature-phone"><Phone src="/img/screen-swipe.jpg" alt="KnewCar Swipe screen" width={300} /></div>
    </div>
  </section>

  <!-- Trust -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow center">Independent</p>
      <h2 class="center">On your side of the table.</h2>
      <div class="grid grid-2 trust">
        <div class="card"><div class="icon-badge"><Icon name="shield" /></div><h3>No credit check</h3><p>You choose an estimated credit range. Your exact score stays on your phone and is never sent to our servers.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="tag" /></div><h3>Manufacturer programs, not ads</h3><p>Offers come from manufacturers' own published programs, and anything sponsored will always be clearly labeled.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="question" /></div><h3>Honest about what's unknown</h3><p>If we can't confirm a discount or rate, we say so instead of guessing, so the estimate isn't better than reality.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="list" /></div><h3>Prepared, not pressured</h3><p>Walk in knowing the programs and the questions to ask. The final deal is still yours to make with the dealer.</p></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="wrap center">
      <h2>Be one of the first to try KnewCar.</h2>
      <p class="lead">Join the beta and we'll email you when your spot opens.</p>
      <div class="cta-form"><Waitlist id="footer-waitlist" /></div>
      <p class="price-line">At launch: {PRICES.trialDays}-day free trial, then from {PRICES.monthly}/month, or a {PRICES.pass} 3-Month Shopper Pass with no recurring fees. <a href="/pricing">See pricing</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; padding: 150px 0 110px; overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(4, 20, 15, 0.92) 0%, rgba(4, 20, 15, 0.55) 45%, rgba(4, 20, 15, 0.92) 85%, var(--ground) 100%),
      url("/img/mountains.jpg") center 30% / cover no-repeat;
  }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; }
  .hero-form { margin-top: 34px; }
  .ticks { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 10px 24px; color: var(--sub); font-size: 15px; }
  .ticks li { display: flex; align-items: center; gap: 8px; }
  .ticks :global(svg) { color: var(--mint); }
  .hero-phones { position: relative; height: 620px; }
  .hero-phones :global(.phone) { position: absolute; }
  .hero-phones :global(.back) { left: 0; top: 40px; opacity: 0.9; }
  .hero-phones :global(.front) { right: 0; top: 0; }

  .problem { border-top: 1px solid rgba(160, 230, 205, 0.08); border-bottom: 1px solid rgba(160, 230, 205, 0.08); background: var(--ground-2); }

  .steps { margin-top: 48px; }
  .steps .card { position: relative; }
  .num { position: absolute; top: 24px; right: 28px; font-size: 44px; font-weight: 800; color: rgba(92, 235, 196, 0.16); line-height: 1; }
  .more { margin-top: 32px; font-weight: 600; }

  .feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .feature-phone { display: flex; justify-content: center; }
  .feature.alt { background: var(--ground-2); }
  .bullets { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 18px; }
  .bullets li { display: flex; gap: 14px; align-items: flex-start; color: var(--sub); font-size: 18px; }
  .bullets :global(svg) { color: var(--mint); flex: none; margin-top: 2px; }

  .trust { margin-top: 48px; }

  .incentives { background: var(--ground-2); border-top: 1px solid rgba(160, 230, 205, 0.08); border-bottom: 1px solid rgba(160, 230, 205, 0.08); }
  .offer-card { padding: 30px; }
  .offer-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .offer-car { margin: 0 !important; color: var(--text) !important; font-size: 20px; font-weight: 700; }
  .offer-zip { margin: 2px 0 0 !important; font-size: 14px; }
  .fresh { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: var(--mint); background: var(--mint-soft); border: 1px solid rgba(92, 235, 196, 0.3); padding: 6px 12px; border-radius: 999px; white-space: nowrap; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 8px var(--mint); }
  .offers { list-style: none; padding: 0; margin: 22px 0 0; display: grid; gap: 12px; }
  .offers li { display: flex; gap: 14px; align-items: flex-start; padding: 16px; border-radius: 14px; background: rgba(4, 20, 15, 0.55); border: 1px solid var(--edge); }
  .offers strong { display: block; font-size: 17px; }
  .offers span:not(.pill) { display: block; color: var(--sub); font-size: 14px; margin-top: 2px; }
  .pill { flex: none; width: 104px; text-align: center; font-size: 12px; font-weight: 800; letter-spacing: .03em; color: var(--mint-ink); background: var(--mint); padding: 5px 10px; border-radius: 8px; margin-top: 2px; }
  .budget-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .body { color: var(--sub); margin: 18px 0 0; max-width: 560px; }
  .rate-card { padding: 32px; }
  .rate-title { font-size: 21px; font-weight: 700; margin: 0 !important; color: var(--text) !important; }
  .rate-sub { margin: 4px 0 0 !important; font-size: 15px; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 17px; }
  th { text-align: left; color: var(--faint); font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 0 0 10px; }
  th:last-child, td:last-child { text-align: right; }
  td { padding: 14px 0; border-top: 1px solid var(--edge); color: var(--sub); }
  td:last-child { color: var(--text); font-weight: 800; font-size: 20px; }
  tbody tr:first-child td:last-child { color: var(--mint); }
  .rate-diff { margin-top: 18px !important; color: var(--text) !important; }
  .rate-diff strong { color: var(--mint); }
  .rate-fine { font-size: 13px; color: var(--faint) !important; }
  .drivers-title { margin: 72px 0 0; font-size: 26px; text-align: center; }
  .drivers { margin-top: 32px; }
  .driver { display: flex; gap: 14px; align-items: flex-start; padding: 22px; border-radius: 16px; border: 1px solid var(--edge); background: rgba(14, 40, 33, 0.45); }
  .driver :global(svg) { color: var(--mint); flex: none; margin-top: 2px; }
  .driver strong { display: block; font-size: 17px; }
  .driver span { display: block; color: var(--sub); font-size: 15px; margin-top: 4px; }

  .cta { background: radial-gradient(800px 360px at 50% 100%, rgba(92, 235, 196, 0.14), transparent 70%); }
  .cta-form { display: flex; justify-content: center; margin-top: 32px; text-align: left; }
  .price-line { color: var(--faint); font-size: 15px; margin-top: 18px; }

  @media (max-width: 900px) {
    .hero { padding: 120px 0 64px; }
    .hero-grid, .feature-grid, .budget-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-phones { height: 480px; max-width: 420px; margin: 0 auto; width: 100%; }
    .hero-phones :global(.back) { --w: 200px !important; }
    .hero-phones :global(.front) { --w: 230px !important; }
    .feature-grid.reverse > :first-child { order: 2; }
    .incentives .budget-grid > :first-child { order: 2; }
  }
</style>
