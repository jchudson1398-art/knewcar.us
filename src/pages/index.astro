---
import Base from "../layouts/Base.astro";
import CarTile from "../components/CarTile.astro";
import SearchBar from "../components/SearchBar.astro";
import { CATALOG, carImage, carUrl, money, priceLabel } from "../lib/catalog";
import { APP_STORE_URL, WEB_PLAN } from "../site";

// The home grid shows every trim by default: four rows of four, with "Show more" for four more rows at a time.
// A toggle switches it to one card per model. The order is reshuffled in the browser on every visit.
const SHOW = 16;
const rank = (k: string) => [...k].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) % 9973, 7);
const mixed = [...CATALOG].sort((a, b) => rank(a.key) - rank(b.key));
const TRIMS = CATALOG.flatMap((car) => car.trims.map((trim) => ({ car, trim })));
const trimPool = [...TRIMS].sort((a, b) => rank(a.car.key + a.trim.name) - rank(b.car.key + b.trim.name)).slice(0, 64);
const modelPool = mixed.slice(0, 32);
const makes = [...new Set(CATALOG.map((c) => c.make))].sort();
// The car on the first slide.
const heroCar = CATALOG.find((c) => c.key === "toyota-rav4")!;
const heroTrim = heroCar.trims.find((t) => t.name === "Limited")!;
// Three priced models of different types for the MSRP slide.
const spotlight = ["Truck", "SUV", "Sedan"].map((t) => mixed.find((c) => c.type === t && c.msrpFrom)!).filter(Boolean);
const brands = new Set(CATALOG.map((c) => c.make)).size;

const steps = [
  { img: "signup", text: "Create a free account" },
  { img: "budget", text: "Tell us what you want to spend" },
  { img: "credit", text: "No credit check, ever" },
  { img: "browse", text: "See the cars that fit you" },
  { img: "swipe", text: "Swipe through your matches" },
  { img: "saved", text: "Save the ones you like" },
  { img: "compare", text: "Compare side by side" },
  { img: "detail", text: "See every offer and rate" },
];
---

<Base title="KnewCar" description={`All your new car options in one easy place. Browse ${CATALOG.length} new models from ${brands} brands, then get the KnewCar app to see offers, incentives and special rates for your situation.`}>
  <!-- Hero: a slideshow. The shopping tool starts a short scroll below it. -->
  <section class="hero" aria-roledescription="carousel" aria-label="What KnewCar does" data-hero>
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="slides">
        <div class="slide" data-slide aria-hidden="false">
          <div class="copy">
            <h1>All your new car options, <span class="grad">One easy place.</span></h1>
            <p class="lead">{CATALOG.length} new models from {brands} brands. Free to browse.</p>
            <div class="hero-cta">
              <a class="btn btn-primary" href="#cars">Start shopping</a>
              <a class="btn btn-ghost" href="/explore">Explore all your options</a>
            </div>
          </div>
          <a class="hero-car" href={carUrl(heroCar)}>
            <img src="/img/hero/toyota-rav4-limited.webp" alt={`${heroCar.year} ${heroCar.make} ${heroCar.model} ${heroTrim.name}`} width="1200" height="900" loading="eager" />
            <span class="hero-cap"><strong>{heroCar.year} {heroCar.make} {heroCar.model} {heroTrim.name}</strong><span>{heroTrim.msrp ? `${money(heroTrim.msrp)} MSRP` : priceLabel(heroCar)} · {heroCar.trims.length} trims</span></span>
          </a>
        </div>

        <div class="slide" data-slide aria-hidden="true">
          <div class="copy">
            <h2 class="h">Every trim. <span class="grad">Real MSRP.</span></h2>
            <p class="lead">See every trim of every model with its manufacturer price, and search by what you want to spend.</p>
            <div class="hero-cta"><a class="btn btn-primary" href="/explore?sort=low">Search by price</a></div>
          </div>
          <div class="stack" aria-hidden="true">
            {spotlight.map((c, i) => (
              <div class={`pcard p${i}`}>
                <img src={carImage(c)} alt="" width="560" height="420" loading="lazy" />
                <div><strong>{c.make} {c.model}</strong><span>{priceLabel(c)} · {c.trims.length} trims</span></div>
              </div>
            ))}
          </div>
        </div>

        <div class="slide" data-slide aria-hidden="true">
          <div class="copy">
            <h2 class="h">Know the real cost <span class="grad">in your state.</span></h2>
            <p class="lead">Upgrade to save cars, compare them side by side, and estimate tax, fees and your payment. {WEB_PLAN.monthly} a month or {WEB_PLAN.yearly} a year.</p>
            <div class="hero-cta"><a class="btn btn-primary" href="/upgrade">See the upgrade</a></div>
          </div>
          <div class="card sample" aria-hidden="true">
            <p class="ex">Example · Texas</p>
            <dl>
              <div><dt>Price with destination</dt><dd>$36,395.00</dd></div>
              <div><dt>State tax (6.25%)</dt><dd>$1,649.69</dd></div>
              <div><dt>Title, registration, doc fee</dt><dd>$525.00</dd></div>
              <div class="t"><dt>Estimated out the door</dt><dd>$38,569.69</dd></div>
            </dl>
            <p class="ex">With a $10,000 trade-in. Fees are estimates.</p>
          </div>
        </div>

        <div class="slide" data-slide aria-hidden="true">
          <div class="copy">
            <h2 class="h">Live in Texas? <span class="grad">Get the app.</span></h2>
            <p class="lead">Browse offers, incentives, special rates and rebates before making your final decision. Find options you may not have thought you could afford.</p>
            <div class="hero-cta"><a class="btn btn-primary" href={APP_STORE_URL}>Download on the App Store</a></div>
          </div>
          <div class="phones" aria-hidden="true">
            <img class="ph back" src="/img/app/swipe.webp" alt="" width="540" height="1105" loading="lazy" />
            <img class="ph front" src="/img/app/browse.webp" alt="" width="540" height="1105" loading="lazy" />
          </div>
        </div>
      </div>

      <div class="hero-nav">
        <div class="pips" role="group" aria-label="Choose a slide">
          {[0, 1, 2, 3].map((i) => <button type="button" data-pip={i} aria-label={`Slide ${i + 1} of 4`} aria-current={i === 0 ? "true" : "false"}></button>)}
        </div>
        <div class="arrows">
          <button type="button" aria-label="Previous slide" data-hprev>‹</button>
          <button type="button" class="next" aria-label="Next slide" data-hnext>›</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Search sits right on top of the listings, the same layout search results use on /explore -->
  <section class="wrap listings" id="cars">
    <SearchBar />
    <nav class="brands" aria-label="Browse by brand">
      {makes.map((mk) => <a class="brand" href={`/explore?make=${encodeURIComponent(mk)}`}>{mk}</a>)}
    </nav>
    <div class="list-head">
      <div>
        <h2>Available <span class="mint">now</span></h2>
        <p class="tally">{TRIMS.length} trims across {CATALOG.length} models. MSRP excludes destination, taxes and fees.</p>
      </div>
      <label class="only-toggle"><input type="checkbox" role="switch" data-models-only /><span class="rail" aria-hidden="true"></span>Models only</label>
    </div>
    <div class="car-grid" data-home-grid>
      {trimPool.map(({ car, trim }, i) => <CarTile car={car} trim={trim} eager={i < 4} hide={i >= SHOW} />)}
      {modelPool.map((car) => <CarTile car={car} hide />)}
    </div>
    <div class="more">
      <button type="button" class="btn btn-ghost" data-more>Show more</button>
      <a class="btn btn-primary" href="/explore">Explore all your options <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- The app: a slider that walks through the real screens -->
  <section class="section app" id="app">
    <div class="wrap app-grid" data-slider>
      <div class="app-copy">
        <div class="copy-a" data-copy="a">
          <h2>Live in Texas? <span class="mint">Get the app</span> and explore all your options based on <span class="grad">YOUR situation.</span></h2>
        </div>
        <div class="copy-b" data-copy="b" hidden>
          <h2>Browse <span class="mint">offers, incentives, special rates and rebates</span> before making your final decision.</h2>
          <p class="afford">Find options you may not have thought you could afford.</p>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><button type="button" data-step={i} aria-current={i === 0 ? "true" : "false"}><span>{String(i + 1).padStart(2, "0")}</span>{s.text}</button></li>
          ))}
        </ol>
        <a class="btn btn-primary" href={APP_STORE_URL}>Download on the App Store</a>
        <p class="fine">The KnewCar app is on iPhone, with offers for Texas shoppers. Payments in the app are estimates.</p>
      </div>
      <div class="window stage">
        <div class="chrome">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="url" data-label>KnewCar app · {steps[0].text}</span>
        </div>
        <div class="viewport tall">
          <div class="track" data-track>
            {steps.map((s, i) => (
              <figure class="shot" data-shot={i} aria-hidden={i === 0 ? "false" : "true"}>
                <img src={`/img/app/${s.img}.webp`} alt={`KnewCar app: ${s.text}`} width="540" height="1105" loading="lazy" />
              </figure>
            ))}
          </div>
          <div class="controls">
            <button type="button" aria-label="Previous screen" data-prev>‹</button>
            <button type="button" class="next" aria-label="Next screen" data-next>›</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Launch video -->
  <section class="section tight">
    <div class="wrap center">
      <h2>See it in <span class="mint">40 seconds.</span></h2>
      <div class="video" data-video>
        <video src="/video/knewcar-launch.mp4" poster="/video/knewcar-launch-poster.jpg" muted loop playsinline preload="none" aria-label="KnewCar launch video"></video>
        <button type="button" class="sound" data-sound aria-pressed="false">Turn sound on</button>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section tight">
    <div class="wrap">
      <div class="card cta">
        <h2>All your new car options. <span class="mint">One easy place.</span></h2>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/explore">Explore all your options</a>
          <a class="btn btn-ghost" href={APP_STORE_URL}>Download on the App Store</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .grad { background: linear-gradient(90deg, #5cebc4 0%, #a6f5df 55%, #ffc45c 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

  /* Hero slideshow */
  .hero { position: relative; padding: 116px 0 28px; overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(900px 480px at 50% -10%, rgba(92, 235, 196, 0.16), transparent 70%),
      linear-gradient(rgba(160, 230, 205, 0.05) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, rgba(160, 230, 205, 0.05) 1px, transparent 1px) 0 0 / 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 85% 80% at 50% 0%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 80% at 50% 0%, #000 35%, transparent 100%);
  }
  .hero .wrap { position: relative; }
  /* Slides share one grid cell, so the hero keeps the height of the tallest slide and nothing jumps. */
  .slides { display: grid; }
  .slide { grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 48px; align-items: center; opacity: 0; visibility: hidden; transform: translateX(24px); transition: opacity .6s ease, transform .6s ease, visibility 0s .6s; }
  .slide[aria-hidden="false"] { opacity: 1; visibility: visible; transform: none; transition: opacity .6s ease, transform .6s ease; }
  .hero h1, .hero .h { font-size: clamp(40px, 5.4vw, 68px); line-height: 1.02; letter-spacing: -0.04em; font-weight: 800; }
  .hero h1 .grad, .hero .h .grad { display: block; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero-nav { display: flex; align-items: center; justify-content: space-between; margin-top: 22px; }
  .pips { display: flex; gap: 4px; }
  .pips button { width: 44px; height: 44px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .pips button::before { content: ""; width: 10px; height: 10px; border-radius: 999px; background: rgba(232, 243, 238, 0.3); transition: width .3s ease, background .3s ease; }
  .pips button[aria-current="true"]::before { width: 30px; background: var(--mint); }
  .arrows { display: flex; gap: 8px; }
  .arrows button { width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(160, 230, 205, 0.3); background: rgba(4, 20, 15, 0.7); color: var(--text); font-size: 24px; line-height: 1; cursor: pointer; }
  .arrows .next { background: var(--mint); border-color: var(--mint); color: var(--mint-ink); }
  .stack { display: grid; grid-template-columns: 1.35fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; height: 380px; }
  .pcard { display: flex; flex-direction: column; min-height: 0; border-radius: 18px; overflow: hidden; background: #0b221c; border: 1px solid rgba(160, 230, 205, 0.2); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5); }
  .pcard img { width: 100%; flex: 1; min-height: 0; height: auto; object-fit: cover; }
  .pcard div { padding: 10px 14px; display: grid; gap: 2px; }
  .pcard strong { font-size: 15px; }
  .pcard span { font-size: 13px; color: var(--mint); font-weight: 600; }
  .p0 { grid-row: 1 / 3; border-color: rgba(92, 235, 196, 0.5); }
  .sample { max-width: 460px; justify-self: center; width: 100%; box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5), 0 0 70px rgba(92, 235, 196, 0.12); }
  .sample dl { margin: 6px 0; }
  .sample dl div { display: flex; justify-content: space-between; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--edge); font-size: 16px; }
  .sample dt { color: var(--sub); }
  .sample dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .sample .t dt, .sample .t dd { color: var(--text); font-weight: 800; font-size: 18px; }
  .sample .ex { margin: 0; font-size: 13px; color: var(--faint); }
  .phones { position: relative; height: 400px; }
  .ph { position: absolute; width: 190px; height: auto; border-radius: 26px; border: 6px solid #070d0b; outline: 1px solid rgba(160, 230, 205, 0.25); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55); }
  .ph.back { left: 18%; top: 20px; transform: rotate(-6deg); opacity: .85; }
  .ph.front { right: 18%; top: 0; }

  /* Browser window */
  .window { border-radius: 16px; overflow: hidden; border: 1px solid rgba(160, 230, 205, 0.22); background: var(--ground); box-shadow: 0 50px 100px rgba(0, 0, 0, 0.6), 0 0 80px rgba(92, 235, 196, 0.12); }
  .chrome { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: #0a1a15; border-bottom: 1px solid rgba(160, 230, 205, 0.12); }
  .dots { display: flex; gap: 7px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: #ff6159; }
  .dots i:nth-child(2) { background: #ffbd2e; }
  .dots i:nth-child(3) { background: #28c940; }
  .url { flex: 1; text-align: center; font-size: 12px; color: var(--sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 47px; }
  .viewport { position: relative; height: 360px; overflow: hidden; }
  .scroller { animation: up 50s linear infinite; }
  .window:hover .scroller { animation-play-state: paused; }
  @keyframes up { to { transform: translateY(-50%); } }
  .mini { padding: 16px 16px 0; display: flex; flex-direction: column; gap: 14px; }
  .mini-search { display: flex; align-items: center; justify-content: space-between; padding: 7px 7px 7px 14px; border-radius: 999px; border: 1px solid rgba(92, 235, 196, 0.35); background: rgba(12, 38, 32, 0.85); font-size: 12px; color: var(--faint); }
  .mini-search b { font-size: 11px; padding: 6px 12px; border-radius: 999px; background: var(--mint); color: var(--mint-ink); }
  .mini-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 12px; }
  .mini-tile { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .mini-pic { border-radius: 12px; background: #0b221c; border: 1px solid rgba(160, 230, 205, 0.1); padding: 9px; }
  .mini-pic img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; }
  .mini-tile small { font-size: 9px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); }
  .mini-tile strong { font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: -3px; }
  .fade { position: absolute; inset: auto 0 0 0; height: 90px; background: linear-gradient(180deg, transparent, var(--ground)); }
  .cursor { position: absolute; left: 62%; top: 40%; filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.5)); animation: cursor 9s ease-in-out infinite; }
  @keyframes cursor { 25% { transform: translate(-160px, 60px); } 45% { transform: translate(-160px, 60px) scale(.85); } 50% { transform: translate(-160px, 60px); } 75% { transform: translate(40px, 140px); } }

  /* Listings */
  .listings { display: flex; flex-direction: column; gap: 22px; padding-top: 8px; padding-bottom: 40px; scroll-margin-top: 90px; }
  .list-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .list-head h2 { font-size: clamp(26px, 3vw, 34px); }
  .tally { margin: 6px 0 0; color: var(--sub); font-size: 15px; }
  .list-head .btn { height: 48px; border-radius: 999px; }
  .car-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px 20px; }
  .brands { display: flex; flex-wrap: wrap; gap: 8px; }
  .brand { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(232, 243, 238, 0.22); color: var(--text); font-size: 15px; font-weight: 600; }
  .brand:hover { border-color: rgba(92, 235, 196, 0.6); text-decoration: none; }
  @media (max-width: 720px) { .brands { flex-wrap: nowrap; overflow-x: auto; margin: 0 -16px; padding: 0 16px 4px; scrollbar-width: none; } .brands::-webkit-scrollbar { display: none; } .brand { flex: none; } }
  .only-toggle { position: relative; flex: none; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: 15px; font-weight: 600; color: var(--text); cursor: pointer; white-space: nowrap; }
  .only-toggle input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .only-toggle .rail { position: relative; width: 46px; height: 26px; border-radius: 999px; background: rgba(232, 243, 238, 0.2); transition: background .2s ease; flex: none; }
  .only-toggle .rail::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: transform .2s ease; }
  .only-toggle input:checked + .rail { background: var(--mint); }
  .only-toggle input:checked + .rail::after { transform: translateX(20px); }
  .only-toggle input:focus-visible + .rail { outline: 2px solid var(--mint); outline-offset: 3px; }
  .more { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .more [hidden] { display: none; }
  .hero-car { position: relative; display: block; border-radius: 24px; overflow: hidden; border: 1px solid rgba(160, 230, 205, 0.2); box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55), 0 0 80px rgba(92, 235, 196, 0.12); }
  .hero-car img { display: block; width: 100%; height: 400px; object-fit: cover; object-position: center 62%; }
  .hero-cap { position: absolute; left: 16px; bottom: 16px; display: grid; gap: 2px; padding: 12px 16px; border-radius: 14px; background: rgba(4, 20, 15, 0.82); border: 1px solid rgba(160, 230, 205, 0.25); backdrop-filter: blur(6px); }
  .hero-cap strong { font-size: 16px; color: var(--text); }
  .hero-cap span { font-size: 14px; font-weight: 600; color: var(--mint); }
  .more { display: flex; justify-content: center; padding-top: 12px; }

  /* App slider */
  .app-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 48px; align-items: center; }
  .app-copy h2 { font-size: clamp(28px, 3.6vw, 42px); line-height: 1.08; }
  .app-copy [hidden] { display: none; }
  .copy-a, .copy-b { min-height: 190px; }
  .afford { color: var(--mint); font-weight: 600; font-size: 19px; margin: 12px 0 0; }
  .steps { list-style: none; margin: 18px 0 22px; padding: 0; display: grid; gap: 4px; }
  .steps button {
    width: 100%; min-height: 44px; display: flex; align-items: center; gap: 14px; padding: 10px 14px; border-radius: 12px;
    border: 1px solid transparent; background: transparent; color: var(--sub); font: 500 16px var(--font); text-align: left; cursor: pointer;
  }
  .steps button span { font-size: 12px; font-weight: 700; color: var(--faint); }
  .steps button:hover { color: var(--text); }
  .steps button[aria-current="true"] { border-color: rgba(92, 235, 196, 0.35); background: rgba(92, 235, 196, 0.08); color: var(--text); font-weight: 600; }
  .steps button[aria-current="true"] span { color: var(--mint); }
  .fine { color: var(--faint); font-size: 13px; margin: 14px 0 0; max-width: 420px; }
  .viewport.tall { height: 600px; background: radial-gradient(ellipse 60% 70% at 50% 50%, rgba(92, 235, 196, 0.1), transparent); }
  .track { position: absolute; top: 30px; left: 50%; display: flex; gap: 36px; margin-left: -125px; transition: transform .9s cubic-bezier(.65, 0, .35, 1); }
  .shot { flex: 0 0 250px; margin: 0; padding: 7px; border-radius: 38px; background: #070d0b; border: 1px solid rgba(160, 230, 205, 0.25); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55); transition: transform .9s cubic-bezier(.65, 0, .35, 1), opacity .9s ease; transform: scale(.86); opacity: .35; }
  .shot[aria-hidden="false"] { transform: none; opacity: 1; }
  .shot img { width: 100%; height: auto; border-radius: 31px; }
  .controls { position: absolute; right: 16px; bottom: 14px; display: flex; gap: 8px; }
  .controls button { width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(160, 230, 205, 0.3); background: rgba(4, 20, 15, 0.7); color: var(--text); font-size: 24px; line-height: 1; cursor: pointer; }
  .controls .next { background: var(--mint); border-color: var(--mint); color: var(--mint-ink); }

  /* Video */
  .video { position: relative; margin: 32px auto 0; max-width: 960px; border-radius: 18px; overflow: hidden; border: 1px solid var(--edge); box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55); background: #000; }
  .video video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .sound { position: absolute; right: 14px; bottom: 14px; height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(160, 230, 205, 0.35); background: rgba(4, 20, 15, 0.8); color: var(--text); font: 600 14px var(--font); cursor: pointer; }
  .sound[aria-pressed="true"] { background: var(--mint); color: var(--mint-ink); border-color: var(--mint); }

  .cta { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 56px 28px; }
  .cta .hero-cta { justify-content: center; }

  @media (max-width: 1000px) { .car-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .hero { padding-top: 96px; }
    .slide, .app-grid { grid-template-columns: 1fr; gap: 28px; }
    .viewport { height: 260px; }
    .stack { height: 300px; }
    .phones { height: 300px; }
    .ph { width: 140px; }
  }
  @media (max-width: 640px) {
    .hero { padding: 84px 0 12px; }
    .slide { gap: 18px; align-items: start; }
    .hero h1, .hero .h { font-size: 36px; }
    .hero .lead { font-size: 16px; margin-top: 10px; }
    .hero-cta { margin-top: 16px; gap: 8px; }
    .hero-cta .btn { min-height: 44px; padding: 0 16px; font-size: 15px; }
    .hero-nav { margin-top: 8px; }
    .viewport { height: 170px; }
    .hero-car img { height: 220px; }
    .hero-cap { left: 10px; bottom: 10px; padding: 8px 12px; }
    .hero-cap strong { font-size: 14px; }
    .stack { height: 220px; gap: 8px; }
    .pcard div { padding: 6px 10px; }
    .pcard strong { font-size: 13px; }
    .pcard span { font-size: 12px; }
    .phones { height: 225px; overflow: hidden; }
    .ph { width: 120px; border-radius: 18px; border-width: 4px; }
    .sample { padding: 12px 16px; }
    .sample dl div { padding: 7px 0; font-size: 14px; }
    .sample .t dt, .sample .t dd { font-size: 15px; }
    .copy-a, .copy-b { min-height: 0; }
  }
  @media (max-width: 720px) { .car-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 14px; } }
  @media (max-width: 420px) { .car-grid { grid-template-columns: 1fr; } .viewport.tall { height: 560px; } }
  @media (prefers-reduced-motion: reduce) { .scroller, .cursor { animation: none; } .track, .shot, .slide { transition: none; } }
</style>

<script>
  // 0) Hero slideshow: advances by itself, pauses while hovered or focused, and stops once someone picks a slide.
  const heroEl = document.querySelector<HTMLElement>("[data-hero]");
  if (heroEl) {
    const slides = [...heroEl.querySelectorAll<HTMLElement>("[data-slide]")];
    const pips = [...heroEl.querySelectorAll<HTMLButtonElement>("[data-pip]")];
    let i = 0;
    let hold = false;
    let stopped = false;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => { s.setAttribute("aria-hidden", String(k !== i)); s.toggleAttribute("inert", k !== i); });
      pips.forEach((b, k) => b.setAttribute("aria-current", String(k === i)));
    };
    pips.forEach((b, k) => b.addEventListener("click", () => { stopped = true; go(k); }));
    heroEl.querySelector("[data-hprev]")!.addEventListener("click", () => { stopped = true; go(i - 1); });
    heroEl.querySelector("[data-hnext]")!.addEventListener("click", () => { stopped = true; go(i + 1); });
    heroEl.addEventListener("pointerenter", () => (hold = true));
    heroEl.addEventListener("pointerleave", () => (hold = false));
    heroEl.addEventListener("focusin", () => (hold = true));
    heroEl.addEventListener("focusout", () => (hold = false));
    let x0 = 0;
    heroEl.addEventListener("touchstart", (e) => (x0 = e.touches[0].clientX), { passive: true });
    heroEl.addEventListener("touchend", (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) { stopped = true; go(i + (dx < 0 ? 1 : -1)); } }, { passive: true });
    go(0);
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) setInterval(() => { if (!hold && !stopped && !document.hidden) go(i + 1); }, 6000);
  }

  // 1) Home grid: every trim by default, or one card per model with the toggle. Shuffled on every visit; four rows
  //    at a time.
  const grid = document.querySelector<HTMLElement>("[data-home-grid]");
  if (grid) {
    const PAGE = 16;
    const more = document.querySelector<HTMLButtonElement>("[data-more]")!;
    const toggle = document.querySelector<HTMLInputElement>("[data-models-only]")!;
    const pools: Record<string, HTMLElement[]> = { trim: [], model: [] };
    grid.querySelectorAll<HTMLElement>("[data-tile]").forEach((t) => pools[t.dataset.kind!].push(t));
    for (const list of Object.values(pools)) {
      for (let i = list.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [list[i], list[j]] = [list[j], list[i]];
      }
      list.forEach((t) => grid.appendChild(t));
    }
    let shown = PAGE;
    const draw = () => {
      const kind = toggle.checked ? "model" : "trim";
      for (const [k, list] of Object.entries(pools)) list.forEach((t, i) => (t.hidden = k !== kind || i >= shown));
      more.hidden = shown >= pools[kind].length;
    };
    more.addEventListener("click", () => { shown += PAGE; draw(); });
    toggle.addEventListener("change", () => { shown = PAGE; draw(); });
    draw();
  }

  // 2) App slider: steps through the app screens; pauses while hovered.
  const slider = document.querySelector<HTMLElement>("[data-slider]");
  if (slider) {
    const shots = [...slider.querySelectorAll<HTMLElement>("[data-shot]")];
    const steps = [...slider.querySelectorAll<HTMLButtonElement>("[data-step]")];
    const track = slider.querySelector<HTMLElement>("[data-track]")!;
    const label = slider.querySelector<HTMLElement>("[data-label]")!;
    const copyA = slider.querySelector<HTMLElement>('[data-copy="a"]')!;
    const copyB = slider.querySelector<HTMLElement>('[data-copy="b"]')!;
    const n = shots.length;
    let at = 0;
    let paused = false;
    const show = (i: number) => {
      at = (i + n) % n;
      track.style.transform = `translateX(-${at * (250 + 36)}px)`;
      shots.forEach((s, k) => s.setAttribute("aria-hidden", String(k !== at)));
      steps.forEach((s, k) => s.setAttribute("aria-current", String(k === at)));
      label.textContent = `KnewCar app · ${steps[at].lastChild?.textContent ?? ""}`;
      copyA.hidden = at >= n / 2;
      copyB.hidden = at < n / 2;
    };
    steps.forEach((s, k) => s.addEventListener("click", () => { paused = true; show(k); }));
    slider.querySelector("[data-prev]")!.addEventListener("click", () => { paused = true; show(at - 1); });
    slider.querySelector("[data-next]")!.addEventListener("click", () => { paused = true; show(at + 1); });
    slider.addEventListener("pointerenter", () => (paused = true));
    slider.addEventListener("pointerleave", () => (paused = false));
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setInterval(() => { if (!paused && !document.hidden) show(at + 1); }, 3200);
    }
  }

  // 3) Launch video: plays muted while on screen; the button turns sound on.
  const box = document.querySelector<HTMLElement>("[data-video]");
  if (box) {
    const video = box.querySelector("video")!;
    const sound = box.querySelector<HTMLButtonElement>("[data-sound]")!;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) video.controls = true;
    else new IntersectionObserver(([e]) => { if (e.isIntersecting) video.play().catch(() => {}); else video.pause(); }, { threshold: 0.4 }).observe(video);
    sound.addEventListener("click", () => {
      video.muted = !video.muted;
      sound.setAttribute("aria-pressed", String(!video.muted));
      sound.textContent = video.muted ? "Turn sound on" : "Sound on";
      if (!video.muted) video.play().catch(() => {});
    });
  }
</script>
