---
import Base from "../layouts/Base.astro";
import CarTile from "../components/CarTile.astro";
import SearchBar from "../components/SearchBar.astro";
import { CATALOG, CONFIG_TOTAL, carImage } from "../lib/catalog";
import { APP_STORE_URL } from "../site";

// The home grid shows 8 rows of 4. Which 32 is reshuffled in the browser on every visit (script below); this
// build-time mix is what loads first and what shows without JavaScript.
const GRID = 32;
const rank = (k: string) => [...k].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) % 9973, 7);
const mixed = [...CATALOG].sort((a, b) => rank(a.key) - rank(b.key));
const first = mixed.slice(0, GRID);
const preview = mixed.slice(GRID, GRID + 15);
const brands = new Set(CATALOG.map((c) => c.make)).size;

const steps = [
  { img: "signup", text: "Create a free account" },
  { img: "budget", text: "Tell us what you want to spend" },
  { img: "credit", text: "No credit check, ever" },
  { img: "browse", text: "See the cars that fit you" },
  { img: "swipe", text: "Swipe through your matches" },
  { img: "saved", text: "Save the ones you like" },
  { img: "compare", text: "Compare side by side" },
  { img: "detail", text: "See every offer and rate" },
];
---

<Base title="KnewCar" description={`All your new car options in one easy place. Browse ${CATALOG.length} new models from ${brands} brands, then get the KnewCar app to see offers, incentives and special rates for your situation.`}>
  <!-- Hero: headline left, a browser window scrolling through the site right -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>All your new car options, <span class="grad">One easy place.</span></h1>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/explore">Explore all your options</a>
          <a class="btn btn-ghost" href={APP_STORE_URL}>Get the app</a>
        </div>
      </div>
      <div class="window" aria-hidden="true">
        <div class="chrome">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="url">knewcar.us/explore</span>
        </div>
        <div class="viewport">
          <div class="scroller">
            {[0, 1].map(() => (
              <div class="mini">
                <div class="mini-search"><span>Search make, model or type</span><b>Search</b></div>
                <div class="mini-grid">
                  {preview.map((c) => (
                    <div class="mini-tile">
                      <div class="mini-pic"><img src={carImage(c)} alt="" width="240" height="180" loading="eager" /></div>
                      <small>{c.make} · {c.year}</small>
                      <strong>{c.model}</strong>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <div class="fade"></div>
          <svg class="cursor" width="22" height="22" viewBox="0 0 24 24"><path d="M4 2l16 9-7 2-3 7z" fill="#fff" stroke="#04140f" stroke-width="1.5" stroke-linejoin="round"></path></svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Search sits right on top of the listings, the same layout search results use on /explore -->
  <section class="wrap listings" id="cars">
    <SearchBar />
    <div class="list-head">
      <div>
        <h2>Available <span class="mint">now</span></h2>
        <p class="tally">{CONFIG_TOTAL.toLocaleString("en-US")} configurations across {CATALOG.length} models, all in the app.</p>
      </div>
      <a class="btn btn-primary" href="/explore">Explore all your options <span aria-hidden="true">→</span></a>
    </div>
    <div class="car-grid" data-home-grid>
      {first.map((car, i) => <CarTile car={car} eager={i < 4} />)}
    </div>
    <div class="more">
      <a class="btn btn-ghost" href="/explore">See all {CATALOG.length} models</a>
    </div>
    <script type="application/json" id="catalog-data" set:html={JSON.stringify(CATALOG.map((c) => [c.key, c.make, c.model, c.year, c.type, c.fuel, c.configs]))} />
  </section>

  <!-- The app: a slider that walks through the real screens -->
  <section class="section app" id="app">
    <div class="wrap app-grid" data-slider>
      <div class="app-copy">
        <div class="copy-a" data-copy="a">
          <h2>Live in Texas? <span class="mint">Get the app</span> and explore all your options based on <span class="grad">YOUR situation.</span></h2>
        </div>
        <div class="copy-b" data-copy="b" hidden>
          <h2>Browse <span class="mint">offers, incentives, special rates and rebates</span> before making your final decision.</h2>
          <p class="afford">Find options you may not have thought you could afford.</p>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><button type="button" data-step={i} aria-current={i === 0 ? "true" : "false"}><span>{String(i + 1).padStart(2, "0")}</span>{s.text}</button></li>
          ))}
        </ol>
        <a class="btn btn-primary" href={APP_STORE_URL}>Download on the App Store</a>
        <p class="fine">The KnewCar app is on iPhone, with offers for Texas shoppers. Payments in the app are estimates.</p>
      </div>
      <div class="window stage">
        <div class="chrome">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="url" data-label>KnewCar app · {steps[0].text}</span>
        </div>
        <div class="viewport tall">
          <div class="track" data-track>
            {steps.map((s, i) => (
              <figure class="shot" data-shot={i} aria-hidden={i === 0 ? "false" : "true"}>
                <img src={`/img/app/${s.img}.webp`} alt={`KnewCar app: ${s.text}`} width="540" height="1105" loading="lazy" />
              </figure>
            ))}
          </div>
          <div class="controls">
            <button type="button" aria-label="Previous screen" data-prev>‹</button>
            <button type="button" class="next" aria-label="Next screen" data-next>›</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Launch video -->
  <section class="section tight">
    <div class="wrap center">
      <h2>See it in <span class="mint">40 seconds.</span></h2>
      <div class="video" data-video>
        <video src="/video/knewcar-launch.mp4" poster="/video/knewcar-launch-poster.jpg" muted loop playsinline preload="none" aria-label="KnewCar launch video"></video>
        <button type="button" class="sound" data-sound aria-pressed="false">Turn sound on</button>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section tight">
    <div class="wrap">
      <div class="card cta">
        <h2>All your new car options. <span class="mint">One easy place.</span></h2>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/explore">Explore all your options</a>
          <a class="btn btn-ghost" href={APP_STORE_URL}>Download on the App Store</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .grad { background: linear-gradient(90deg, #5cebc4 0%, #a6f5df 55%, #ffc45c 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

  /* Hero */
  .hero { position: relative; padding: 150px 0 64px; overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(900px 480px at 50% -10%, rgba(92, 235, 196, 0.16), transparent 70%),
      linear-gradient(rgba(160, 230, 205, 0.05) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, rgba(160, 230, 205, 0.05) 1px, transparent 1px) 0 0 / 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 85% 80% at 50% 0%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 80% at 50% 0%, #000 35%, transparent 100%);
  }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 56px; align-items: center; }
  .hero h1 { font-size: clamp(44px, 6.2vw, 78px); line-height: 1; letter-spacing: -0.04em; }
  .hero h1 .grad { display: block; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  /* Browser window */
  .window { border-radius: 16px; overflow: hidden; border: 1px solid rgba(160, 230, 205, 0.22); background: var(--ground); box-shadow: 0 50px 100px rgba(0, 0, 0, 0.6), 0 0 80px rgba(92, 235, 196, 0.12); }
  .chrome { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: #0a1a15; border-bottom: 1px solid rgba(160, 230, 205, 0.12); }
  .dots { display: flex; gap: 7px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: #ff6159; }
  .dots i:nth-child(2) { background: #ffbd2e; }
  .dots i:nth-child(3) { background: #28c940; }
  .url { flex: 1; text-align: center; font-size: 12px; color: var(--sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 47px; }
  .viewport { position: relative; height: 460px; overflow: hidden; }
  .scroller { animation: up 50s linear infinite; }
  .window:hover .scroller { animation-play-state: paused; }
  @keyframes up { to { transform: translateY(-50%); } }
  .mini { padding: 16px 16px 0; display: flex; flex-direction: column; gap: 14px; }
  .mini-search { display: flex; align-items: center; justify-content: space-between; padding: 7px 7px 7px 14px; border-radius: 999px; border: 1px solid rgba(92, 235, 196, 0.35); background: rgba(12, 38, 32, 0.85); font-size: 12px; color: var(--faint); }
  .mini-search b { font-size: 11px; padding: 6px 12px; border-radius: 999px; background: var(--mint); color: var(--mint-ink); }
  .mini-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 12px; }
  .mini-tile { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .mini-pic { border-radius: 12px; background: #0b221c; border: 1px solid rgba(160, 230, 205, 0.1); padding: 9px; }
  .mini-pic img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; }
  .mini-tile small { font-size: 9px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); }
  .mini-tile strong { font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: -3px; }
  .fade { position: absolute; inset: auto 0 0 0; height: 90px; background: linear-gradient(180deg, transparent, var(--ground)); }
  .cursor { position: absolute; left: 62%; top: 40%; filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.5)); animation: cursor 9s ease-in-out infinite; }
  @keyframes cursor { 25% { transform: translate(-160px, 60px); } 45% { transform: translate(-160px, 60px) scale(.85); } 50% { transform: translate(-160px, 60px); } 75% { transform: translate(40px, 140px); } }

  /* Listings */
  .listings { display: flex; flex-direction: column; gap: 22px; padding-top: 8px; padding-bottom: 40px; scroll-margin-top: 90px; }
  .list-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .list-head h2 { font-size: clamp(26px, 3vw, 34px); }
  .tally { margin: 6px 0 0; color: var(--sub); font-size: 15px; }
  .list-head .btn { height: 48px; border-radius: 999px; }
  .car-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px 20px; }
  .more { display: flex; justify-content: center; padding-top: 12px; }

  /* App slider */
  .app-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 48px; align-items: center; }
  .app-copy h2 { font-size: clamp(28px, 3.6vw, 42px); line-height: 1.08; }
  .app-copy [hidden] { display: none; }
  .copy-a, .copy-b { min-height: 190px; }
  .afford { color: var(--mint); font-weight: 600; font-size: 19px; margin: 12px 0 0; }
  .steps { list-style: none; margin: 18px 0 22px; padding: 0; display: grid; gap: 4px; }
  .steps button {
    width: 100%; min-height: 44px; display: flex; align-items: center; gap: 14px; padding: 10px 14px; border-radius: 12px;
    border: 1px solid transparent; background: transparent; color: var(--sub); font: 500 16px var(--font); text-align: left; cursor: pointer;
  }
  .steps button span { font-size: 12px; font-weight: 700; color: var(--faint); }
  .steps button:hover { color: var(--text); }
  .steps button[aria-current="true"] { border-color: rgba(92, 235, 196, 0.35); background: rgba(92, 235, 196, 0.08); color: var(--text); font-weight: 600; }
  .steps button[aria-current="true"] span { color: var(--mint); }
  .fine { color: var(--faint); font-size: 13px; margin: 14px 0 0; max-width: 420px; }
  .viewport.tall { height: 600px; background: radial-gradient(ellipse 60% 70% at 50% 50%, rgba(92, 235, 196, 0.1), transparent); }
  .track { position: absolute; top: 30px; left: 50%; display: flex; gap: 36px; margin-left: -125px; transition: transform .9s cubic-bezier(.65, 0, .35, 1); }
  .shot { flex: 0 0 250px; margin: 0; padding: 7px; border-radius: 38px; background: #070d0b; border: 1px solid rgba(160, 230, 205, 0.25); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55); transition: transform .9s cubic-bezier(.65, 0, .35, 1), opacity .9s ease; transform: scale(.86); opacity: .35; }
  .shot[aria-hidden="false"] { transform: none; opacity: 1; }
  .shot img { width: 100%; height: auto; border-radius: 31px; }
  .controls { position: absolute; right: 16px; bottom: 14px; display: flex; gap: 8px; }
  .controls button { width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(160, 230, 205, 0.3); background: rgba(4, 20, 15, 0.7); color: var(--text); font-size: 24px; line-height: 1; cursor: pointer; }
  .controls .next { background: var(--mint); border-color: var(--mint); color: var(--mint-ink); }

  /* Video */
  .video { position: relative; margin: 32px auto 0; max-width: 960px; border-radius: 18px; overflow: hidden; border: 1px solid var(--edge); box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55); background: #000; }
  .video video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .sound { position: absolute; right: 14px; bottom: 14px; height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(160, 230, 205, 0.35); background: rgba(4, 20, 15, 0.8); color: var(--text); font: 600 14px var(--font); cursor: pointer; }
  .sound[aria-pressed="true"] { background: var(--mint); color: var(--mint-ink); border-color: var(--mint); }

  .cta { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 56px 28px; }
  .cta .hero-cta { justify-content: center; }

  @media (max-width: 1000px) { .car-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .hero { padding-top: 120px; }
    .hero-grid, .app-grid { grid-template-columns: 1fr; gap: 40px; }
    .viewport { height: 380px; }
    .copy-a, .copy-b { min-height: 0; }
  }
  @media (max-width: 720px) { .car-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 14px; } }
  @media (max-width: 420px) { .car-grid { grid-template-columns: 1fr; } .viewport.tall { height: 560px; } }
  @media (prefers-reduced-motion: reduce) { .scroller, .cursor { animation: none; } .track, .shot { transition: none; } }
</style>

<script>
  // 1) Home grid: show a different random 32 on every visit.
  const grid = document.querySelector<HTMLElement>("[data-home-grid]");
  const raw = document.getElementById("catalog-data")?.textContent;
  if (grid && raw) {
    type Row = [key: string, make: string, model: string, year: number, type: string | null, fuel: string | null, configs: number];
    const all = JSON.parse(raw) as Row[];
    for (let i = all.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [all[i], all[j]] = [all[j], all[i]];
    }
    grid.querySelectorAll<HTMLElement>("[data-tile]").forEach((tile, i) => {
      const row = all[i];
      if (!row) return;
      const [key, make, model, year, type, fuel, configs] = row;
      const name = `${year} ${make} ${model}`;
      const img = tile.querySelector<HTMLImageElement>("[data-img]")!;
      img.src = `/img/cars/${key}.webp`;
      img.alt = name;
      const link = tile.querySelector<HTMLAnchorElement>("[data-link]")!;
      link.href = `/cars/${key}/`;
      link.setAttribute("aria-label", `${name}: see all trims`);
      tile.querySelector<HTMLAnchorElement>("[data-link2]")!.href = `/cars/${key}/`;
      tile.querySelector("[data-configs]")!.textContent = `${configs} ${configs === 1 ? "configuration" : "configurations"} in the app`;
      tile.querySelector("[data-meta]")!.textContent = `${make} · ${year}`;
      tile.querySelector("[data-name]")!.textContent = model;
      const tag = tile.querySelector<HTMLElement>("[data-tag]")!;
      tag.textContent = type ?? "";
      tag.hidden = !type;
      const fuelTag = tile.querySelector<HTMLElement>("[data-fuel-tag]")!;
      fuelTag.textContent = fuel ?? "";
      fuelTag.hidden = !fuel;
    });
  }

  // 2) App slider: steps through the app screens; pauses while hovered.
  const slider = document.querySelector<HTMLElement>("[data-slider]");
  if (slider) {
    const shots = [...slider.querySelectorAll<HTMLElement>("[data-shot]")];
    const steps = [...slider.querySelectorAll<HTMLButtonElement>("[data-step]")];
    const track = slider.querySelector<HTMLElement>("[data-track]")!;
    const label = slider.querySelector<HTMLElement>("[data-label]")!;
    const copyA = slider.querySelector<HTMLElement>('[data-copy="a"]')!;
    const copyB = slider.querySelector<HTMLElement>('[data-copy="b"]')!;
    const n = shots.length;
    let at = 0;
    let paused = false;
    const show = (i: number) => {
      at = (i + n) % n;
      track.style.transform = `translateX(-${at * (250 + 36)}px)`;
      shots.forEach((s, k) => s.setAttribute("aria-hidden", String(k !== at)));
      steps.forEach((s, k) => s.setAttribute("aria-current", String(k === at)));
      label.textContent = `KnewCar app · ${steps[at].lastChild?.textContent ?? ""}`;
      copyA.hidden = at >= n / 2;
      copyB.hidden = at < n / 2;
    };
    steps.forEach((s, k) => s.addEventListener("click", () => { paused = true; show(k); }));
    slider.querySelector("[data-prev]")!.addEventListener("click", () => { paused = true; show(at - 1); });
    slider.querySelector("[data-next]")!.addEventListener("click", () => { paused = true; show(at + 1); });
    slider.addEventListener("pointerenter", () => (paused = true));
    slider.addEventListener("pointerleave", () => (paused = false));
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setInterval(() => { if (!paused && !document.hidden) show(at + 1); }, 3200);
    }
  }

  // 3) Launch video: plays muted while on screen; the button turns sound on.
  const box = document.querySelector<HTMLElement>("[data-video]");
  if (box) {
    const video = box.querySelector("video")!;
    const sound = box.querySelector<HTMLButtonElement>("[data-sound]")!;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) video.controls = true;
    else new IntersectionObserver(([e]) => { if (e.isIntersecting) video.play().catch(() => {}); else video.pause(); }, { threshold: 0.4 }).observe(video);
    sound.addEventListener("click", () => {
      video.muted = !video.muted;
      sound.setAttribute("aria-pressed", String(!video.muted));
      sound.textContent = video.muted ? "Turn sound on" : "Sound on";
      if (!video.muted) video.play().catch(() => {});
    });
  }
</script>
