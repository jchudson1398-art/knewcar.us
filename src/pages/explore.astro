---
import Base from "../layouts/Base.astro";
import CarTile from "../components/CarTile.astro";
import SearchBar from "../components/SearchBar.astro";
import { CATALOG, CONFIGS, FILTERS } from "../lib/catalog";
import { APP_STORE_URL } from "../site";

const cars = [...CATALOG].sort((a, b) => a.make.localeCompare(b.make) || a.model.localeCompare(b.model));
const makes = [...new Set(cars.map((c) => c.make))].sort();
const brands = makes.length;
// Every configuration gets its own card; the "Models only" toggle switches to one card per model.
const configs = [...CONFIGS].sort((a, b) => a.car.make.localeCompare(b.car.make) || a.car.model.localeCompare(b.car.model) || b.config.year - a.config.year);
---

<Base title="Explore all your options" description={`Browse and search every configuration of ${cars.length} new models from ${brands} brands in one place. Trucks, SUVs, sedans, hybrids and electric cars.`}>
  <section class="page-head">
    <div class="wrap wide">
      <p class="eyebrow">{configs.length.toLocaleString("en-US")} configurations · {cars.length} models · {brands} brands</p>
      <h1>Explore <span class="mint">your options.</span></h1>
      <p class="lead">Browse every new-car configuration and compare the ones that fit your needs and budget.</p>
    </div>
  </section>

  <section class="wrap wide results" data-explore>
    <SearchBar />

    <div class="chips" role="group" aria-label="Filter by type">
      {FILTERS.map((f) => (
        <button type="button" class="chip" data-chip={f} aria-pressed={f === "All" ? "true" : "false"}>{f}</button>
      ))}
      <button type="button" class="chip" data-awd aria-pressed="false">All-wheel drive</button>
    </div>

    <div class="chips" role="group" aria-label="Filter by brand">
      <button type="button" class="chip" data-make="" aria-pressed="true">All brands</button>
      {makes.map((mk) => <button type="button" class="chip" data-make={mk} aria-pressed="false">{mk}</button>)}
    </div>

    <div class="tools">
      <div class="seg" role="group" aria-label="Show"><button type="button" data-view="config" aria-pressed="true">Configurations</button><button type="button" data-view="model" aria-pressed="false">Models</button></div>
      <label>Sort by
        <select data-sort>
          <option value="name">Make and model</option>
          <option value="low">MSRP: low to high</option>
          <option value="high">MSRP: high to low</option>
        </select>
      </label>
    </div>

    <div class="status">
      <p aria-live="polite" data-count>All {configs.length.toLocaleString("en-US")} configurations</p>
      <button type="button" class="clear" data-clear hidden>Clear search</button>
    </div>

    <div class="car-grid">
      {configs.map(({ car, config }, i) => <CarTile car={car} config={config} eager={i < 8} />)}
      {cars.map((car) => <CarTile car={car} hide />)}
    </div>

    <div class="empty" data-empty hidden>
      <h2>No matches for that search yet</h2>
      <p>Try a make, a model, or a type like truck, SUV, sedan, hybrid or electric.</p>
      <button type="button" class="btn btn-primary" data-clear>Show all models</button>
    </div>

    <div class="card app-note">
      <div>
        <h2>Live in Texas? <span class="mint">See the numbers in the app.</span></h2>
        <p>Offers, incentives, special rates and rebates for each of these cars, based on your situation. MSRP on this page excludes destination, taxes and fees.</p>
      </div>
      <a class="btn btn-primary" href={APP_STORE_URL}>Download on the App Store</a>
    </div>
  </section>
</Base>

<style>
  .results { display: flex; flex-direction: column; gap: 22px; padding-top: 8px; padding-bottom: 72px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(232, 243, 238, 0.22); background: transparent;
    color: var(--text); font: 500 15px var(--font); cursor: pointer;
  }
  .chip:hover { border-color: rgba(92, 235, 196, 0.6); }
  .chip[aria-pressed="true"] { background: var(--mint); border-color: var(--mint); color: var(--mint-ink); font-weight: 700; box-shadow: 0 0 24px rgba(92, 235, 196, 0.4); }
  .tools { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; }
  .seg { display: inline-flex; padding: 4px; border-radius: 12px; border: 1px solid rgba(232, 243, 238, 0.28); background: rgba(4, 20, 15, 0.6); }
  .seg button { min-height: 40px; padding: 0 22px; border: 0; border-radius: 9px; background: transparent; color: var(--text); font: 600 15px var(--font); cursor: pointer; }
  .seg button[aria-pressed="true"] { background: var(--mint); color: var(--mint-ink); }
  .page-head .lead { margin-top: 8px; }
  .only-toggle { position: relative; flex: none; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: 15px; font-weight: 600; color: var(--text); cursor: pointer; white-space: nowrap; }
  .only-toggle input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .only-toggle .rail { position: relative; width: 46px; height: 26px; border-radius: 999px; background: rgba(232, 243, 238, 0.2); transition: background .2s ease; flex: none; }
  .only-toggle .rail::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: transform .2s ease; }
  .only-toggle input:checked + .rail { background: var(--mint); }
  .only-toggle input:checked + .rail::after { transform: translateX(20px); }
  .only-toggle input:focus-visible + .rail { outline: 2px solid var(--mint); outline-offset: 3px; }
  .tools label { display: flex; align-items: center; gap: 8px; color: var(--sub); font-size: 15px; }
  .tools select { height: 44px; padding: 0 12px; border-radius: 10px; border: 1px solid rgba(232, 243, 238, 0.22); background: var(--card-solid); color: var(--text); font: 500 15px var(--font); }
  .status { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; min-height: 44px; }
  .status p { margin: 0; color: var(--sub); font-size: 16px; }
  .clear { background: none; border: 0; color: var(--mint); font: 600 15px var(--font); cursor: pointer; padding: 10px 0; min-height: 44px; }
  .clear:hover { text-decoration: underline; }
  .car-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 22px 16px; }

  @media (max-width: 720px) { .car-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 14px; } }
  /* On a phone each chip row is one line that scrolls sideways, so results start sooner. */
  @media (max-width: 720px) { .chips { flex-wrap: nowrap; overflow-x: auto; margin: 0 -16px; padding: 0 16px 4px; scrollbar-width: none; } .chips::-webkit-scrollbar { display: none; } .chip { flex: none; } }
  @media (max-width: 420px) { .car-grid { grid-template-columns: 1fr; } }
  .empty { text-align: center; padding: 48px 24px; border: 1px dashed rgba(160, 230, 205, 0.28); border-radius: 20px; }
  .empty[hidden] { display: none; }
  .empty h2 { font-size: 24px; }
  .empty p { color: var(--sub); margin: 10px 0 20px; }
  .app-note { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; margin-top: 32px; }
  .app-note h2 { font-size: clamp(24px, 3vw, 32px); }
  .app-note p { max-width: 560px; }
</style>

<script>
  // Search and type filters for the Explore page. The page works without this script: every car is listed.
  const root = document.querySelector<HTMLElement>("[data-explore]");
  if (root) {
    const tiles = [...root.querySelectorAll<HTMLElement>("[data-tile]")];
    const input = root.querySelector<HTMLInputElement>("input[name=q]")!;
    const form = root.querySelector<HTMLFormElement>("[data-search]")!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-chip]")];
    const makeChips = [...root.querySelectorAll<HTMLButtonElement>("button[data-make]")];
    const views = [...root.querySelectorAll<HTMLButtonElement>("[data-view]")];
    const awdChip = root.querySelector<HTMLButtonElement>("[data-awd]")!;
    let kind = "config";
    let awd = false;
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-empty]")!;
    const clears = [...root.querySelectorAll<HTMLButtonElement>("[data-clear]")];
    const params = new URLSearchParams(location.search);
    let query = (params.get("q") ?? "").trim();
    const maxSel = root.querySelector<HTMLSelectElement>("[data-max]")!;
    const sortSel = root.querySelector<HTMLSelectElement>("[data-sort]")!;
    const grid = root.querySelector<HTMLElement>(".car-grid")!;
    let max = Number(params.get("max")) || 0;
    let sort = ["low", "high"].includes(params.get("sort") ?? "") ? params.get("sort")! : "name";
    let type = chips.some((c) => c.dataset.chip === params.get("type")) ? params.get("type")! : "All";
    let make = makeChips.some((c) => c.dataset.make === params.get("make")) ? params.get("make")! : "";
    kind = params.get("view") === "models" ? "model" : "config";
    awd = params.get("awd") === "1";


    const matchesType = (t: HTMLElement) =>
      type === "All" ||
      t.dataset.type === type ||
      (type === "Electric" && t.dataset.fuel === "Electric") ||
      (type === "Hybrid" && (t.dataset.fuel ?? "").startsWith("Hybrid"));

    function apply(updateUrl = true) {
      // "trucks" should find "truck": drop a trailing s from each word before matching.
      const words = query.toLowerCase().split(/\s+/).filter(Boolean).map((w) => (w.length > 3 ? w.replace(/s$/, "") : w));
      let shown = 0;
      const noun = kind === "model" ? "models" : "configurations";
      for (const t of tiles) {
        const price = Number(t.dataset.price) || 0;
        const ok = t.dataset.kind === kind && (!awd || kind === "model" || ["AWD", "4WD"].includes(t.dataset.drive ?? "")) && (!make || t.dataset.make === make) && matchesType(t) && words.every((w) => (t.dataset.text ?? "").includes(w)) && (!max || (price > 0 && price < max));
        t.hidden = !ok;
        if (ok) shown++;
      }
      const priceOf = (t: HTMLElement) => Number(t.dataset.price) || (sort === "high" ? -1 : Infinity);
      [...tiles]
        .sort((a, b) => sort === "name" ? (a.dataset.nameSort ?? "").localeCompare(b.dataset.nameSort ?? "") : sort === "low" ? priceOf(a) - priceOf(b) : priceOf(b) - priceOf(a))
        .forEach((t) => grid.appendChild(t));
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.chip === type)));
      makeChips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.make === make)));
      views.forEach((v) => v.setAttribute("aria-pressed", String(v.dataset.view === kind)));
      awdChip.setAttribute("aria-pressed", String(awd));
      awdChip.hidden = kind === "model";
      const what = [make, type === "All" ? "" : type, awd && kind === "config" ? "all-wheel drive" : "", noun].filter(Boolean).join(" ");
      const plain = !query && type === "All" && !make && !max && !(awd && kind === "config");
      count.textContent = query ? `${shown} ${shown === 1 ? "result" : "results"} for “${query}”${what === noun ? "" : ` in ${what}`}` : plain ? `All ${shown.toLocaleString("en-US")} ${noun}` : `${shown} ${what}`;
      if (max) count.textContent += ` under $${max.toLocaleString("en-US")} MSRP`;
      empty.hidden = shown !== 0;
      clears[0].hidden = plain;
      if (updateUrl) {
        const next = new URLSearchParams();
        if (query) next.set("q", query);
        if (type !== "All") next.set("type", type);
        if (make) next.set("make", make);
        if (kind === "model") next.set("view", "models");
        if (awd) next.set("awd", "1");
        if (max) next.set("max", String(max));
        if (sort !== "name") next.set("sort", sort);
        const qs = next.toString();
        history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
      }
    }

    input.value = query;
    input.addEventListener("input", () => { query = input.value.trim(); apply(); });
    form.addEventListener("submit", (e) => { e.preventDefault(); query = input.value.trim(); apply(); input.blur(); });
    chips.forEach((c) => c.addEventListener("click", () => { type = c.dataset.chip!; apply(); }));
    makeChips.forEach((c) => c.addEventListener("click", () => { make = c.dataset.make!; apply(); }));
    views.forEach((v) => v.addEventListener("click", () => { kind = v.dataset.view!; apply(); }));
    awdChip.addEventListener("click", () => { awd = !awd; apply(); });
    maxSel.value = max ? String(max) : "";
    sortSel.value = sort;
    maxSel.addEventListener("change", () => { max = Number(maxSel.value) || 0; apply(); });
    sortSel.addEventListener("change", () => { sort = sortSel.value; apply(); });
    clears.forEach((b) => b.addEventListener("click", () => { query = ""; type = "All"; make = ""; awd = false; max = 0; maxSel.value = ""; input.value = ""; apply(); }));
    apply(false);
  }
</script>
